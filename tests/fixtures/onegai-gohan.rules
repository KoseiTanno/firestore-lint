rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // 自分自身は常に読める。
      // それ以外は「自分と userId が同じpairに属している」場合にのみ読める。
      // これにより pairCode / email / pushToken が無関係な認証ユーザーに
      // 漏れることを防ぐ。
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairId != null &&
          exists(/databases/$(database)/documents/pairs/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairId)) &&
          request.auth.uid in get(/databases/$(database)/documents/pairs/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairId)).data.members &&
          userId in get(/databases/$(database)/documents/pairs/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.pairId)).data.members
        )
      );
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    match /pairs/{pairId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow update: if request.auth != null && request.auth.uid in resource.data.members;
    }
    match /pairs/{pairId}/menus/{menuId} {
      allow read, write: if request.auth != null &&
        get(/databases/$(database)/documents/pairs/$(pairId)).data.members.hasAny([request.auth.uid]);
    }
    match /pairs/{pairId}/orders/{orderId} {
      allow read: if request.auth != null &&
        get(/databases/$(database)/documents/pairs/$(pairId)).data.members.hasAny([request.auth.uid]);
      allow create: if request.auth != null &&
        get(/databases/$(database)/documents/pairs/$(pairId)).data.members.hasAny([request.auth.uid]);
      // status は受け手（orderedFor）だけが 'accepted' / 'completed' に更新できる。
      // thankedAt（ごちそうさま）は注文した側（orderedBy）だけが、完了後に一度だけ設定できる。
      allow update: if request.auth != null &&
        get(/databases/$(database)/documents/pairs/$(pairId)).data.members.hasAny([request.auth.uid])
        && (
          (
            resource.data.orderedFor == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['accepted', 'completed']
          ) || (
            resource.data.orderedBy == request.auth.uid
            && resource.data.status == 'completed'
            && !resource.data.keys().hasAny(['thankedAt'])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['thankedAt'])
          )
        );
    }
    // ファネル計測イベント。クライアントは自分のuidでの作成のみ可能。
    // 読み取り・更新・削除は不可（集計はAdmin SDK / コンソールで行う）。
    match /events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'params', 'uid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.params is map;
      allow read, update, delete: if false;
    }
  }
}
